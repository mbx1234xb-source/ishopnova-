      <div class="footer-col"><h4>دسترسی سریع</h4><a href="#home">خانه</a><a href="#products">محصولات</a><a href="#brands-section">برندها</a></div>
      <div class="footer-col"><h4>پشتیبانی</h4><p>۲۴ ساعت مهلت تعویض کالا</p><p>۱ سال گارانتی تعویض (فستر و گرین لاین)</p></div>
      <div class="footer-col">
        <h4>تماس با ما</h4>
        <p><i class="fa-solid fa-phone"></i> ۰۹۰۰۱۷۳۹۷۷۷</p>
        <p><i class="fa-solid fa-location-dot"></i> ایران، خوزستان، خرمشهر، خیابان حافظ نو، نبش قاآنی</p>
        <div class="trust-badge">نماد اعتماد</div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© ۲۰۲۶ آی‌شاپ نوا. تمامی حقوق محفوظ است.</p>
      <a href="admin.html" class="admin-link"><i class="fa-solid fa-lock"></i> پنل مدیریت</a>
    </div>
  </div>
</footer>

<script>
const K = { products:'ishopnova_products', cart:'ishopnova_cart', wish:'ishopnova_wishlist', settings:'ishopnova_settings', users:'ishopnova_users', session:'ishopnova_session', orders:'ishopnova_orders' };

const DEFAULT_PRODUCTS = [
  {id:1,name:"ساعت هوشمند TELZEAL WH-05 Pro Max Screen",brand:"Telzeal",cat:"ساعت هوشمند",price:4700000,old:null,sale:null,rating:5,warranty:"۲۴ ساعت مهلت تعویض",images:["https://picsum.photos/seed/tz1/500/500"]},
  {id:2,name:"دسته بازی و خنک‌کننده پرودو Chillcore",brand:"Porodo",cat:"لوازم گیمینگ",price:6200000,old:null,sale:null,rating:5,warranty:"۲۴ ساعت مهلت تعویض",images:["https://picsum.photos/seed/pr1/500/500"]},
  {id:3,name:"ایرپاد فستر Raptor ANC+ENC",brand:"Faster",cat:"هدفون بلوتوثی",price:2590000,old:null,sale:null,rating:5,warranty:"۱ سال گارانتی تعویض",images:["https://picsum.photos/seed/fs1/500/500"]},
  {id:4,name:"ساعت هوشمند گرین لاین Strive نارنجی",brand:"Green Lion",cat:"ساعت هوشمند",price:3250000,old:null,sale:null,rating:5,warranty:"۱ سال گارانتی تعویض",images:["https://picsum.photos/seed/gl1/500/500"]},
  {id:5,name:"شارژر دیواری پاورولوژی ۱۴۰ وات",brand:"Powerology",cat:"شارژر و آداپتور",price:9700000,old:null,sale:null,rating:5,warranty:"۲۴ ساعت مهلت تعویض",images:["https://picsum.photos/seed/pw1/500/500"]},
];
const DEFAULT_BRANDS = ["Faster","Green Lion","Porodo","Powerology","Telzeal","Porodo Gaming"];

function get(key, fallback){ const v = localStorage.getItem(key); if(v){ try{return JSON.parse(v);}catch(e){} } return fallback; }
function set(key, val){ localStorage.setItem(key, JSON.stringify(val)); }

function getProducts(){ let p = get(K.products,null); if(!p){ set(K.products,DEFAULT_PRODUCTS); p=DEFAULT_PRODUCTS; } return p; }
function getSettings(){ return get(K.settings, {logo:'', banners:[], brands:DEFAULT_BRANDS.map(n=>({name:n,logo:''}))}); }
function getCart(){ return get(K.cart, []); }
function saveCart(c){ set(K.cart,c); updateBadges(); }
function getWish(){ return get(K.wish, []); }
function saveWish(w){ set(K.wish,w); updateBadges(); }
function getUsers(){ return get(K.users, []); }
function getSession(){ return get(K.session, null); }
function getOrders(){ return get(K.orders, []); }
function saveOrders(o){ set(K.orders,o); }
function fmtPrice(n){ return n.toLocaleString('fa-IR') + ' تومان'; }
let currentFilterCat = 'همه', currentFilterBrand = null;

// ---------- Logo ----------
function renderLogo(){
  const s = getSettings();
  const nav = document.getElementById('navLogo');
  nav.innerHTML = s.logo ? `<img src="${s.logo}" alt="logo">iShop Nova` : `<i class="fa-solid fa-bolt"></i>iShop Nova`;
}

// ---------- Hero Slider ----------
let sliderIdx = 0, sliderTimer;
function renderSlider(){
  const s = getSettings();
  const el = document.getElementById('heroSlider');
  if(!s.banners || s.banners.length===0){
    el.innerHTML = `<div class="slide active slide-default"><div><h2>خریدی مطمئن، سریع و آسان</h2><p>با تنوعی بی‌نظیر — هدف ما، رضایت شماست</p></div></div>`;
    return;
  }
  el.innerHTML = s.banners.map((b,i)=>`<div class="slide ${i===0?'active':''}" style="background-image:url('${b}')"></div>`).join('') +
    `<div class="slider-dots">${s.banners.map((b,i)=>`<span class="${i===0?'active':''}"></span>`).join('')}</div>`;
  if(s.banners.length>1){
    clearInterval(sliderTimer);
    sliderTimer = setInterval(()=>{
      const slides = el.querySelectorAll('.slide'); const dots = el.querySelectorAll('.slider-dots span');
      slides[sliderIdx].classList.remove('active'); dots[sliderIdx].classList.remove('active');
      sliderIdx = (sliderIdx+1) % slides.length;
      slides[sliderIdx].classList.add('active'); dots[sliderIdx].classList.add('active');
    }, 3500);
  }
}

// ---------- Brand row ----------
function renderBrands(){
  const s = getSettings();
  const brands = (s.brands && s.brands.length) ? s.brands : DEFAULT_BRANDS.map(n=>({name:n,logo:''}));
  const row = document.getElementById('brandRow');
  row.innerHTML = `<div class="brand-chip ${!currentFilterBrand?'active':''}" data-brand=""><div class="fallback-icon"><i class="fa-solid fa-border-all"></i></div><span>همه</span></div>` +
    brands.map(b=>`<div class="brand-chip ${currentFilterBrand===b.name?'active':''}" data-brand="${b.name}">
      ${b.logo ? `<img src="${b.logo}" alt="${b.name}">` : `<div class="fallback-icon">${b.name.charAt(0)}</div>`}
      <span>${b.name}</span>
    </div>`).join('');
  row.querySelectorAll('.brand-chip').forEach(chip=>{
    chip.addEventListener('click',()=>{
      currentFilterBrand = chip.dataset.brand || null;
      renderBrands(); renderProducts();
      document.getElementById('products').scrollIntoView({behavior:'smooth'});
    });
  });
}

function renderStars(r){ let s=''; for(let i=1;i<=5;i++){ s += i<=r ? '★' : '<span style="color:var(--text-dimmer)">★</span>'; } return s; }

function productCard(p){
  const imgs = p.images && p.images.length ? p.images : ['https://picsum.photos/seed/'+p.id+'/500/500'];
  return `
  <div class="product-card" data-cat="${p.cat}" data-brand="${p.brand}">
    <div class="product-media" data-id="${p.id}">
      ${p.sale ? `<span class="badge-sale">-${p.sale}%</span>` : ''}
      ${p.warranty ? `<span class="badge-warranty">${p.warranty}</span>` : ''}
      ${imgs.length>1 ? `<span class="img-count"><i class="fa-solid fa-images"></i> ${imgs.length}</span>` : ''}
      <img src="${imgs[0]}" alt="${p.name}" loading="lazy">
    </div>
    <div class="product-info">
      <span class="product-brand">${p.brand || ''}</span>
      <h3>${p.name}</h3>
      <div class="stars">${renderStars(p.rating||5)}</div>
      <div class="price-row"><span class="price">${fmtPrice(p.price)}</span>${p.old ? `<span class="old-price">${fmtPrice(p.old)}</span>` : ''}</div>
      <div class="action-row">
        <button class="add-cart" data-id="${p.id}"><i class="fa-solid fa-bag-shopping"></i> افزودن</button>
        <button class="wish-btn ${getWish().includes(p.id)?'active':''}" data-id="${p.id}"><i class="fa-${getWish().includes(p.id)?'solid':'regular'} fa-heart"></i></button>
      </div>
    </div>
  </div>`;
}

function renderProducts(){
  const products = getProducts();
  const grid = document.getElementById('productGrid');
  if(products.length === 0){ grid.innerHTML = `<div class="empty-state">هنوز محصولی اضافه نشده.</div>`; document.getElementById('filters').innerHTML=''; return; }
  let filtered = products;
  if(currentFilterBrand) filtered = filtered.filter(p=>p.brand===currentFilterBrand);
  grid.innerHTML = filtered.length ? filtered.map(productCard).join('') : `<div class="empty-state">محصولی در این دسته پیدا نشد.</div>`;

  const cats = ['همه', ...new Set(products.map(p=>p.cat))];
  document.getElementById('filters').innerHTML = cats.map(c=>`<button class="filter-btn ${c===currentFilterCat?'active':''}" data-filter="${c}">${c}</button>`).join('');
  document.querySelectorAll('.filter-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      currentFilterCat = btn.dataset.filter;
      document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.product-card').forEach(card=>{
        card.classList.toggle('hidden', currentFilterCat!=='همه' && card.dataset.cat!==currentFilterCat);
      });
    });
  });
}

// Gallery
document.addEventListener('click', e=>{
  const media = e.target.closest('.product-media');
  if(media){
    const p = getProducts().find(x=>x.id==media.dataset.id);
    const imgs = p.images && p.images.length ? p.images : ['https://picsum.photos/seed/'+p.id+'/500/500'];
    document.getElementById('galleryMain').src = imgs[0];
    document.getElementById('galleryThumbs').innerHTML = imgs.map((im,i)=>`<img src="${im}" class="${i===0?'active':''}" data-src="${im}">`).join('');
    document.getElementById('galleryModal').classList.add('show');
  }
  const thumb = e.target.closest('.gallery-thumbs img');
  if(thumb){ document.getElementById('galleryMain').src = thumb.dataset.src; document.querySelectorAll('.gallery-thumbs img').forEach(i=>i.classList.remove('active')); thumb.classList.add('active'); }
});
document.getElementById('galleryClose').addEventListener('click',()=>document.getElementById('galleryModal').classList.remove('show'));
document.getElementById('galleryModal').addEventListener('click', e=>{ if(e.target.id==='galleryModal') e.target.classList.remove('show'); });

// Wishlist & Cart actions
document.addEventListener('click', e=>{
  const wb = e.target.closest('.wish-btn');
  if(wb){ const id = Number(wb.dataset.id); let wish = getWish(); wish = wish.includes(id) ? wish.filter(x=>x!==id) : [...wish,id]; saveWish(wish); renderProducts(); renderWish(); }
  const ac = e.target.closest('.add-cart');
  if(ac){ const id = Number(ac.dataset.id); let cart = getCart(); const ex = cart.find(x=>x.id===id); if(ex) ex.qty++; else cart.push({id,qty:1}); saveCart(cart);
    ac.classList.add('added'); ac.innerHTML='<i class="fa-solid fa-check"></i> اضافه شد'; setTimeout(()=>{ ac.classList.remove('added'); ac.innerHTML='<i class="fa-solid fa-bag-shopping"></i> افزودن'; },1200); }
});

function updateBadges(){ const cart=getCart(); document.getElementById('cartCount').textContent = cart.reduce((s,i)=>s+i.qty,0); document.getElementById('wishCount').textContent = getWish().length; }

function renderCart(){
  const cart = getCart(); const products = getProducts(); const body = document.getElementById('cartBody');
  if(cart.length===0){ body.innerHTML = `<p style="color:var(--text-dimmer);text-align:center;padding:40px 0;">سبد خرید خالی است</p>`; document.getElementById('cartTotal').textContent='۰ تومان'; return; }
  let total = 0;
  body.innerHTML = cart.map(item=>{
    const p = products.find(x=>x.id===item.id); if(!p) return ''; total += p.price*item.qty;
    const img = (p.images && p.images[0]) || 'https://picsum.photos/seed/'+p.id+'/100/100';
    return `<div class="cart-item"><img src="${img}"><div class="info"><h4>${p.name}</h4><span class="price-sm">${fmtPrice(p.price)}</span>
      <div class="qty-control"><button class="qty-minus" data-id="${p.id}">-</button><span>${item.qty}</span><button class="qty-plus" data-id="${p.id}">+</button>
      <button class="remove-item" data-id="${p.id}"><i class="fa-solid fa-trash"></i></button></div></div></div>`;
  }).join('');
  document.getElementById('cartTotal').textContent = fmtPrice(total);
}
document.addEventListener('click', e=>{
  const id = e.target.closest('[data-id]')?.dataset.id; if(!id) return;
  let cart = getCart(); const item = cart.find(x=>x.id===Number(id));
  if(e.target.closest('.qty-plus') && item){ item.qty++; saveCart(cart); renderCart(); }
  if(e.target.closest('.qty-minus') && item){ item.qty--; if(item.qty<=0) cart = cart.filter(x=>x.id!==Number(id)); saveCart(cart); renderCart(); }
  if(e.target.closest('.remove-item') && !e.target.closest('#wishBody')){ cart = cart.filter(x=>x.id!==Number(id)); saveCart(cart); renderCart(); }
});

function renderWish(){
  const wish = getWish(); const products = getProducts(); const body = document.getElementById('wishBody');
  if(wish.length===0){ body.innerHTML = `<p style="color:var(--text-dimmer);text-align:center;padding:40px 0;">لیست علاقه‌مندی خالی است</p>`; return; }
  body.innerHTML = wish.map(id=>{
    const p = products.find(x=>x.id===id); if(!p) return '';
    const img = (p.images && p.images[0]) || 'https://picsum.photos/seed/'+p.id+'/100/100';
    return `<div class="cart-item"><img src="${img}"><div class="info"><h4>${p.name}</h4><span class="price-sm">${fmtPrice(p.price)}</span></div><button class="remove-item" data-wid="${p.id}"><i class="fa-solid fa-trash"></i></button></div>`;
  }).join('');
}
document.addEventListener('click', e=>{ const w = e.target.closest('[data-wid]'); if(w){ saveWish(getWish().filter(x=>x!==Number(w.dataset.wid))); renderWish(); renderProducts(); } });

// Drawers & mobile menu
const overlay = document.getElementById('overlayBg');
document.getElementById('cartBtn').addEventListener('click',()=>{ renderCart(); document.getElementById('cartDrawer').classList.add('open'); overlay.classList.add('show'); });
document.getElementById('closeCart').addEventListener('click',()=>{ document.getElementById('cartDrawer').classList.remove('open'); overlay.classList.remove('show'); });
document.getElementById('wishBtn').addEventListener('click',()=>{ renderWish(); document.getElementById('wishDrawer').classList.add('open'); overlay.classList.add('show'); });
document.getElementById('closeWish').addEventListener('click',()=>{ document.getElementById('wishDrawer').classList.remove('open'); overlay.classList.remove('show'); });
overlay.addEventListener('click',()=>{ document.getElementById('cartDrawer').classList.remove('open'); document.getElementById('wishDrawer').classList.remove('open'); overlay.classList.remove('show'); });

const mobileMenu = document.getElementById('mobileMenu'), menuOverlay = document.getElementById('menuOverlay');
document.getElementById('burgerBtn').addEventListener('click',()=>{ mobileMenu.classList.add('open'); menuOverlay.classList.add('show'); });
document.getElementById('closeMenu').addEventListener('click',()=>{ mobileMenu.classList.remove('open'); menuOverlay.classList.remove('show'); });
menuOverlay.addEventListener('click',()=>{ mobileMenu.classList.remove('open'); menuOverlay.classList.remove('show'); });
mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{ mobileMenu.classList.remove('open'); menuOverlay.classList.remove('show'); }));

// ---------- Auth ----------
let pendingOtp = null, pendingPhone = null;
const authModal = document.getElementById('authModal');
function openAuth(){
  const session = getSession();
  document.getElementById('authStep1').style.display='none';
  document.getElementById('authStep2').style.display='none';
  document.getElementById('authStep3').style.display='none';
  if(session){ document.getElementById('authStep3').style.display='block'; document.getElementById('welcomeMsg').textContent = 'شما با شماره ' + session.phone + ' وارد شده‌اید'; }
  else{ document.getElementById('authStep1').style.display='block'; }
  authModal.classList.add('show');
}
document.getElementById('authBtn').addEventListener('click', openAuth);
document.getElementById('closeAuth').addEventListener('click',()=>authModal.classList.remove('show'));
document.getElementById('sendOtpBtn').addEventListener('click',()=>{
  const phone = document.getElementById('authPhone').value.trim();
  if(!/^09\d{9}$/.test(phone)){ alert('شماره موبایل معتبر نیست (مثال: 09123456789)'); return; }
  pendingPhone = phone;
  pendingOtp = String(Math.floor(1000 + Math.random()*9000));
  document.getElementById('demoOtpNote').textContent = 'حالت نمایشی: کد تایید شما ' + pendingOtp + ' است (در نسخه واقعی پیامک می‌شود)';
  document.getElementById('authStep1').style.display='none';
  document.getElementById('authStep2').style.display='block';
  document.querySelectorAll('.otp-boxes input').forEach(i=>i.value='');
  document.querySelectorAll('.otp-boxes input')[0].focus();
});
document.querySelectorAll('.otp-boxes input').forEach((inp,idx,arr)=>{
  inp.addEventListener('input',()=>{ if(inp.value && arr[idx+1]) arr[idx+1].focus(); });
});
document.getElementById('verifyOtpBtn').addEventListener('click',()=>{
  const code = Array.from(document.querySelectorAll('.otp-boxes input')).map(i=>i.value).join('');
  if(code !== pendingOtp){ alert('کد وارد شده اشتباه است'); return; }
  let users = getUsers();
  let user = users.find(u=>u.phone===pendingPhone);
  if(!user){ user = { phone: pendingPhone, createdAt: new Date().toISOString() }; users.push(user); set(K.users, users); }
  set(K.session, user);
  document.getElementById('authStep2').style.display='none';
  document.getElementById('authStep3').style.display='block';
  document.getElementById('welcomeMsg').textContent = 'شما با شماره ' + pendingPhone + ' وارد شدید';
});
document.getElementById('logoutBtn').addEventListener('click',()=>{ localStorage.removeItem(K.session); authModal.classList.remove('show'); });

// ---------- Checkout ----------
const checkoutModal = document.getElementById('checkoutModal');
document.getElementById('goCheckout').addEventListener('click',()=>{
  if(getCart().length===0){ alert('سبد خرید شما خالی است'); return; }
  document.getElementById('checkoutStep1').style.display='block';
  document.getElementById('checkoutStep2').style.display='none';
  document.getElementById('checkoutStep3').style.display='none';
  const session = getSession();
  if(session){ document.getElementById('custPhone').value = session.phone; }
  checkoutModal.classList.add('show');
  document.getElementById('cartDrawer').classList.remove('open'); overlay.classList.remove('show');
});
document.getElementById('closeCheckout').addEventListener('click',()=>checkoutModal.classList.remove('show'));
document.getElementById('goPayment').addEventListener('click',()=>{
  const name = document.getElementById('custName').value.trim();
  const phone = document.getElementById('custPhone').value.trim();
  const address = document.getElementById('custAddress').value.trim();
  if(!name || !/^09\d{9}$/.test(phone) || !address){ alert('لطفاً همه فیلدها را به‌درستی پر کنید'); return; }
  const products = getProducts(); const cart = getCart();
  let total = 0; cart.forEach(i=>{ const p = products.find(x=>x.id===i.id); if(p) total += p.price*i.qty; });
  document.getElementById('payAmount').textContent = fmtPrice(total);
  document.getElementById('checkoutStep1').style.display='none';
  document.getElementById('checkoutStep2').style.display='block';
});
document.getElementById('confirmPay').addEventListener('click',()=>{
  const products = getProducts(); const cart = getCart();
  let total = 0; const items = cart.map(i=>{ const p = products.find(x=>x.id===i.id); if(p) total += p.price*i.qty; return { id:i.id, name:p?p.name:'', qty:i.qty, price:p?p.price:0 }; });
  const orderNum = 'IN-' + Date.now().toString().slice(-8);
  const order = {
    orderNum, date: new Date().toISOString(),
    customer: { name: document.getElementById('custName').value.trim(), phone: document.getElementById('custPhone').value.trim(), address: document.getElementById('custAddress').value.trim() },
    items, total, status: 'در انتظار بررسی'
  };
  const orders = getOrders(); orders.unshift(order); saveOrders(orders);
  saveCart([]);
  document.getElementById('orderNumBox').textContent = 'کد سفارش: ' + orderNum;
  document.getElementById('checkoutStep2').style.display='none';
  document.getElementById('checkoutStep3').style.display='block';
});
document.getElementById('closeOrderDone').addEventListener('click',()=>checkoutModal.classList.remove('show'));

renderLogo(); renderSlider(); renderBrands(); renderProducts(); updateBadges();
setTimeout(()=>{ const l=document.getElementById('loader'); if(l) l.classList.add('hide'); }, 600);
</script>
</body>
